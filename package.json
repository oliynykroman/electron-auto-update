{
  "name": "electron-update-demo",
  "productName": "Центр оновлення",
  "version": "1.0.0",
  "private": true,
  "description": "Анонімна демонстрація оновлення вебінтерфейсу Electron-застосунку",
  "author": "Анонімний автор",
  "main": "electron/main.js",
  "scripts": {
    "start": "npm run start:local",
    "start:local": "ng build --configuration local && node scripts/set-env.js local && electron .",
    "start:remote": "node scripts/set-env.js production && electron .",
    "start:web": "ng serve"
  },
  "dependencies": {
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@angular/platform-browser-dynamic": "21.2.25",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.26",
    "@angular/cli": "21.2.26",
    "@angular/compiler-cli": "21.2.25",
    "electron": "^33.2.0",
    "typescript": "~5.9.3"
  }
}
